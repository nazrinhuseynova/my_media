<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\my_media.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:53464</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Pulse.API\Pulse.API.csproj" />
    <None Include="Pulse.API\Pulse.API.csproj.user" />
    <None Include="Pulse.Application\Pulse.Application.csproj" />
    <None Include="Pulse.Domain\Pulse.Domain.csproj" />
    <None Include="Pulse.Infrastructure\Pulse.Infrastructure.csproj" />
    <None Include="Pulse.slnx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>8.*-*</Version>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\my_media.client\Pulse.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
